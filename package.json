{
  "name": "package-soup",
  "version": "1.0.0",
  "description": "Synchronously extract and format npm package specifiers from mixed text.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "npm",
    "package",
    "parser",
    "semver",
    "specifier",
    "formatter"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:site": "vite build",
    "dev:site": "vite",
    "prepack": "npm run build",
    "preview:site": "vite preview",
    "test": "npm run build && node --test"
  },
  "engines": {
    "node": ">=20.17.0"
  },
  "dependencies": {
    "npm-package-arg": "^13.0.2",
    "semver": "^7.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reggi/package-soup.git"
  },
  "homepage": "https://reggi.github.io/package-soup/",
  "bugs": {
    "url": "https://github.com/reggi/package-soup/issues"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/npm-package-arg": "^6.1.4",
    "@types/semver": "^7.7.0",
    "path-browserify": "^1.0.1",
    "typescript": "^5.9.2",
    "vite": "^8.2.0",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "license": "MIT"
}
